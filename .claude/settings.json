{
  "permissions": {
    "allow": [
      "Bash(./scripts/sujets.sh:*)",
      "Bash(./scripts/git-publier.sh:*)",
      "Bash(./scripts/git-sync.sh:*)",
      "Bash(./scripts/notion-etat.sh:*)",
      "Bash(./scripts/config.sh:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/auth.json)",
      "Read(**/config/jwt/**)",
      "Read(**/kubernetes/**/*secret*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/git-sync.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/config.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sujets.sh contexte"
          }
        ]
      }
    ]
  }
}
