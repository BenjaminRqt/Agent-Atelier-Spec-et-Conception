# Configuration de l'atelier — valeurs par défaut, COMMITÉES (aucune donnée d'équipe ici).
# Chaque équipe crée un .env.local (non commité) qui surcharge ces clés :
#     cp .env .env.local   puis remplir .env.local
# Le hook de démarrage injecte la configuration dans la session (./scripts/config.sh).

ATELIER_ENTREPRISE=""
ATELIER_EQUIPE=""
ATELIER_UTILISATEUR=""
ATELIER_ROLE=""
ATELIER_DESTINATAIRES="l'équipe dev, et le PO pour le cadrage et la spec"
ATELIER_PROJET_DIR=""                  # chemin du projet cible, ex. "~/Workspace/mon-projet"
ATELIER_DOSSIER=".atelier"             # dossier de l'atelier dans le projet
PROJET_GIT_DISTANT="origin"
PROJET_GIT_BRANCHE_PRINCIPALE="main"

NOTION_RACINE_NOM="Specs & conception"
NOTION_RACINE_URL=""

# Seul site et seul projet Jira où l'atelier peut créer / modifier
JIRA_SITE=""
JIRA_CLOUD_ID=""
JIRA_PROJET=""
JIRA_PROJET_NOM=""
JIRA_BOARD=""
JIRA_TYPES="Epic, Story, Tâche, Bug"

MIRO_BOARD_URL=""
FIGMA_FICHIER_URL=""

GIT_DISTANT="origin"
GIT_BRANCHE_PRINCIPALE="main"
GIT_BRANCHE_TRAVAIL="travail"
